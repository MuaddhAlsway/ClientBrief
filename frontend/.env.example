# MU.LAB Client Intake — frontend environment (all optional)
# Leave VITE_API_URL empty in development; Vite proxies /api to http://localhost:5000.
VITE_API_URL=
# Public URL of the privacy policy (defaults to /privacy.html).
VITE_PRIVACY_URL=/privacy.html
# Enables the direct file-upload control. Leave false unless signed storage is configured.
VITE_STORAGE_ENABLED=false
