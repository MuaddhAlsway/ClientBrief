# MU.LAB Client Intake — environment template
# Copy to backend/.env and fill in real values. NEVER commit the real .env.

# ── Backend (backend/.env) ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma separated allowed browser origins (frontend URL(s))
CLIENT_URL=http://localhost:5173

# Gmail SMTP — use a Google App Password, never your normal password.
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
OWNER_EMAIL=your-account@gmail.com

# Optional
MAIL_FROM_NAME=MU.LAB
SEND_CLIENT_CONFIRMATION=true
PRIVACY_POLICY_URL=https://mulab.example/privacy

# Turso / libSQL durable persistence (optional; in-memory fallback otherwise)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Frontend (frontend/.env) — all optional ───────────────────────────────
# Leave VITE_API_URL empty in development (the Vite proxy forwards /api to :5000).
# Set it to your deployed API origin in production, e.g. https://api.mulab.example
# VITE_API_URL=
# VITE_PRIVACY_URL=https://mulab.example/privacy
# VITE_STORAGE_ENABLED=false
