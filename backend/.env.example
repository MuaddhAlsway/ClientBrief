# MU.LAB Client Intake — Backend environment
PORT=5000
NODE_ENV=development

# Comma separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# Gmail SMTP (use a Google App Password, never your normal password)
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
OWNER_EMAIL=your-account@gmail.com

# Optional: SMTP endpoint overrides (defaults to smtp.gmail.com:465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional: display name for the sender
MAIL_FROM_NAME=MU.LAB

# Optional: send a confirmation email to the client (true/false)
SEND_CLIENT_CONFIRMATION=true

# Public link to the privacy policy shown in the client confirmation email
PRIVACY_POLICY_URL=https://mulab.example/privacy

# ── Turso / libSQL (durable persistence) ──────────────────────────────────
# When set, submissions and idempotency state persist across restarts and
# instances. When omitted, a bounded in-memory store is used.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
